@* Uređivanje jednostavnog popisa (sekcije, vrste članstva, vrste akcija i dodaci s bodovima): dodaj, preimenuj, bodovi, sakrij *@

<form class="d-flex gap-2 mb-3" style="max-width:480px" @onsubmit="Dodaj" @onsubmit:preventDefault>
    <input class="form-control" placeholder="@Placeholder" @bind="_novi" />
    @if (Servis.ImaBodove)
    {
        <input class="form-control text-end" style="max-width:110px" placeholder="bodova" @bind="_noviBodovi" />
    }
    <button class="btn btn-primary text-nowrap">➕ Dodaj</button>
</form>
<Poruka Tekst="@_greska" />

@if (_stavke.Count > 0)
{
    <table class="table align-middle" style="max-width:720px">
        <thead><tr><th>Naziv</th>@if (Servis.ImaBodove){<th style="width:120px">Bodova</th>}@if (BrojClanova != null){<th>Članova</th>}<th></th></tr></thead>
        <tbody>
            @foreach (var s in _stavke)
            {
                <tr class="@(s.Skrivena ? "text-muted" : "")">
                    <td>
                        @if (_uredi == s.Id)
                        {
                            <input class="form-control form-control-sm" @bind="_naziv" />
                        }
                        else
                        {
                            @s.Naziv
                            @if (s.Skrivena) {<span class="badge text-bg-secondary ms-1">skriveno</span>}
                        }
                    </td>
                    @if (Servis.ImaBodove)
                    {
                        <td><input class="form-control form-control-sm text-end" value="@Evidencija.Pomoc.Tekst.Bodovi(s.Bodovi)" @onchange="e => PromijeniBodove(s, e.Value?.ToString())" /></td>
                    }
                    @if (BrojClanova != null){<td>@BrojClanova(s.Id)</td>}
                    <td class="text-end text-nowrap">
                        @if (_uredi == s.Id)
                        {
                            <button class="btn btn-sm btn-primary" @onclick="() => Preimenuj(s)">Spremi</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _uredi = null">Odustani</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => { _uredi = s.Id; _naziv = s.Naziv; _greska = null; }">✏️ Preimenuj</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Sakrij(s)">@(s.Skrivena ? "👁️ Prikaži" : "🙈 Sakrij")</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="small text-muted">Skriveno se ne nudi kod novih upisa; članovi koji to već imaju zadržavaju.</p>
}

@code {
    [Parameter, EditorRequired] public Sifrarnik Servis { get; set; } = null!;
    [Parameter] public string Placeholder { get; set; } = "Naziv";
    [Parameter] public Func<string, int>? BrojClanova { get; set; }
    [Parameter] public EventCallback Promjena { get; set; }

    private List<Stavka> _stavke = [];
    private string _novi = "", _naziv = "";
    private string? _noviBodovi;
    private string? _uredi, _greska;

    protected override void OnParametersSet() => _stavke = Servis.Sve(iSkrivene: true);

    private async Task Osvjezi()
    {
        _stavke = Servis.Sve(iSkrivene: true);
        await Promjena.InvokeAsync();
    }

    private async Task Dodaj()
    {
        _greska = Servis.Greska(_novi);
        if (_greska != null) return;
        double? bodovi = null;
        if (Servis.ImaBodove && (bodovi = Evidencija.Pomoc.Tekst.ProcitajBroj(_noviBodovi)) == null) { _greska = "Upišite bodove (npr. 5 ili 2,5)."; return; }
        var id = Servis.Dodaj(_novi);
        if (bodovi != null) Servis.PostaviBodove(id, bodovi.Value);
        _novi = "";
        _noviBodovi = null;
        await Osvjezi();
    }

    private async Task Preimenuj(Stavka s)
    {
        _greska = Servis.Greska(_naziv, s.Id);
        if (_greska != null) return;
        Servis.Preimenuj(s.Id, _naziv);
        _uredi = null;
        await Osvjezi();
    }

    private async Task PromijeniBodove(Stavka s, string? tekst)
    {
        if (Evidencija.Pomoc.Tekst.ProcitajBroj(tekst) is not { } b) { _greska = $"Bodovi za „{s.Naziv}“ nisu ispravni."; return; }
        _greska = null;
        Servis.PostaviBodove(s.Id, b);
        await Osvjezi();
    }

    private async Task Sakrij(Stavka s)
    {
        Servis.Sakrij(s.Id, !s.Skrivena);
        await Osvjezi();
    }
}
