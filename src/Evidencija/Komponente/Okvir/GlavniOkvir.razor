@inherits LayoutComponentBase
@inject Sjednica Sjednica

<div class="page">
    <div class="sidebar">
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" href=""><img src="logo-evidencija.svg" alt="" width="26" height="26" /> Evidencija</a>
            </div>
        </div>
        <div class="nav-scrollable">
            <nav class="nav flex-column">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">🏠 Početna</NavLink>
                <NavLink class="nav-link" href="clanovi">👥 Članovi</NavLink>
                <NavLink class="nav-link" href="imenik">📒 Imenik</NavLink>
                <NavLink class="nav-link" href="clanarina">💶 Članarina</NavLink>
                <NavLink class="nav-link" href="bodovi/upis">➕ Upis bodova</NavLink>
                <NavLink class="nav-link" href="bodovi" Match="NavLinkMatch.All">🔨 Bodovi</NavLink>
                <div class="izbornik-naslov">Postavke</div>
                <NavLink class="nav-link" href="postavke/udruga">🏛️ Udruga i uplatnica</NavLink>
                <NavLink class="nav-link" href="postavke/clanarina">💶 Iznosi članarine</NavLink>
                <NavLink class="nav-link" href="postavke/bodovi">🔨 Bodovi i oprema</NavLink>
                <NavLink class="nav-link" href="postavke/sekcije">🏷️ Sekcije</NavLink>
                <NavLink class="nav-link" href="postavke/kopije">💾 Sigurnosne kopije</NavLink>
                <NavLink class="nav-link" href="uvoz">📥 Uvoz članova</NavLink>
                <NavLink class="nav-link" href="postavke/lozinka">🔑 Lozinka</NavLink>
                <div class="izbornik-naslov">Program</div>
                <NavLink class="nav-link" href="upute">📖 Upute</NavLink>
            </nav>
            <div class="program-potpis">
                <img src="logo-evidencija.svg" alt="" width="22" height="22" />
                <span>Evidencija za Windows · @Verzija</span>
            </div>
        </div>
    </div>
    <main>
        <div class="top-row px-4">
            <button type="button" class="btn btn-link p-0" @onclick="Sjednica.Zakljucaj">🔒 Zaključaj</button>
        </div>
        <article class="content px-4 pb-5">
            @Body
        </article>
    </main>
</div>

@code {
    private static readonly string Verzija =
        typeof(GlavniOkvir).Assembly.GetName().Version?.ToString(3) ?? "";
}
