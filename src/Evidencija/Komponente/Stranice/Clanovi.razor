@page "/clanovi"
@inject ClanoviServis Servis
@inject SekcijeServis Sekcije
@using Evidencija.Pomoc

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0 me-auto">👥 Članovi</h1>
    <PdfGumb Izradi="IzradiPdf" Spremljeno="p => _pdf = p" />
    <a class="btn btn-primary no-print" href="clanovi/novi">➕ Novi član</a>
</div>
@if (_pdf != null){<div class="alert alert-success py-2 small no-print">📄 PDF spremljen: @_pdf</div>}

<ClanFilter Upit="@_upit" SekcijaId="@_sekcijaId" Status="@_status" PrikaziStatus="true" Promjena="Filtriraj" />

@if (_svi.Count == 0)
{
    <div class="alert alert-secondary">Još nema članova. Dodajte prvog gumbom <b>➕ Novi član</b>.</div>
}
else
{
    <p class="small text-muted">Prikazano: @_prikaz.Count od @_svi.Count</p>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th></th><th>Prezime i ime</th>@if (_imaSekcija){<th>Sekcija</th>}<th>Mobitel</th><th>Mjesto</th><th>Iskaznica</th></tr></thead>
            <tbody>
                @foreach (var c in _prikaz)
                {
                    <tr class="klikabilno" @onclick='() => Nav.NavigateTo("clanovi/" + c.Id)'>
                        <td style="width:52px"><ClanSlika Clan="c" /></td>
                        <td>
                            <b>@c.PrezimeIme</b>
                            @if (!string.IsNullOrEmpty(c.Nadimak)) {<span class="text-muted"> „@c.Nadimak“</span>}
                            @if (c.Status == Clan.Izasao) {<span class="badge text-bg-secondary ms-1">izašao</span>}
                        </td>
                        @if (_imaSekcija){<td>@NazivSekcije(c.SekcijaId)</td>}
                        <td>@c.MobilniTelefon</td>
                        <td>@c.Mjesto</td>
                        <td><IskaznicaOznaka Clan="c" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Inject] private UdrugaServis UdrugaZaPdf { get; set; } = null!;
    private string? _pdf;
    private string NazivUdruge => UdrugaZaPdf.Ucitaj().Naziv is { Length: > 0 } n ? n : "Lovačka udruga";
    private string? IzradiPdf() => Evidencija.Pomoc.PdfIzvoz.SpremiIOtvori(PdfPopis.Tablica(NazivUdruge, "Popis članova",
        $"{(_status == Clan.Izasao ? "Izašli članovi" : _status == null ? "Svi članovi" : "Aktivni članovi")}{(_sekcijaId != null ? " · " + NazivSekcije(_sekcijaId) : "")} · {_prikaz.Count}",
        [new("Prezime i ime", 3), new("Nadimak", 1.5f), new("Sekcija", 2), new("Mobitel", 2), new("Mjesto", 2), new("Iskaznica do", 1.5f)],
        _prikaz.Select(c => new[] { c.PrezimeIme, c.Nadimak ?? "", NazivSekcije(c.SekcijaId), c.MobilniTelefon ?? "", c.Mjesto ?? "", Tekst.Datum(c.IskaznicaVrijediDo) })),
        "Popis clanova.pdf");
    [Inject] private NavigationManager Nav { get; set; } = null!;

    private List<Clan> _svi = [], _prikaz = [];
    private Dictionary<string, string> _sekcije = [];
    private bool _imaSekcija;
    private string? _upit, _sekcijaId;
    private int? _status = Clan.Aktivan;

    protected override void OnInitialized()
    {
        _svi = Servis.Svi();
        _sekcije = Sekcije.Sve(true).ToDictionary(s => s.Id, s => s.Naziv);
        _imaSekcija = _sekcije.Count > 0;
        Filtriraj((null, null, Clan.Aktivan));
    }

    private void Filtriraj((string? Upit, string? SekcijaId, int? Status) f)
    {
        (_upit, _sekcijaId, _status) = f;
        _prikaz = ClanoviServis.Filtriraj(_svi, _upit, _sekcijaId, _status).ToList();
    }

    private string NazivSekcije(string? id) => id != null && _sekcije.TryGetValue(id, out var n) ? n : "";
}
