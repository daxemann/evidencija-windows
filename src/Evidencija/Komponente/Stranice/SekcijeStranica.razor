@page "/postavke/sekcije"
@inject SekcijeServis Servis
@inject ClanoviServis Clanovi

<h1 class="h3 mb-1">🏷️ Sekcije</h1>
<p class="text-muted small mb-3">Samo podatak gdje tko pripada – za filtar u popisima i na ispisu. Bez sekcija se ništa od toga ne prikazuje.</p>

<SifrarnikUredi Servis="Servis" Placeholder="Naziv nove sekcije" BrojClanova="@(id => _broj.GetValueOrDefault(id))" />

@code {
    private Dictionary<string, int> _broj = [];

    protected override void OnInitialized() =>
        _broj = Clanovi.Svi().Where(c => c.SekcijaId != null && c.Status == Clan.Aktivan)
            .GroupBy(c => c.SekcijaId!).ToDictionary(g => g.Key, g => g.Count());
}
